# Copy to .env (repo root) and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- General ---
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production (structured JSON logs)
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
# Used by docker-compose to create the database:
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind
# Used by the app when running outside docker (docker-compose overrides it).
# Percent-encode special characters in the password: @ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25
#   python -c "from urllib.parse import quote; print(quote('your-password', safe=''))"
DATABASE_URL=postgresql+asyncpg://documind:change-me@localhost:5432/documind
# Integration tests only — a dedicated database whose name contains "test" (it is wiped):
# TEST_DATABASE_URL=postgresql+asyncpg://documind:change-me@localhost:5432/documind_test

# --- Redis (job queue, rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Auth ---
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false                # must be true in production (HTTPS)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Uploads ---
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=20
DEFAULT_DOCUMENT_VISIBILITY=organization   # private | organization | restricted

# --- Ingestion (Phase 3) ---
# Changing the embedding model or chunking creates a NEW Qdrant collection; then run
#   python -m app.cli reindex --stale
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5      # local ONNX via fastembed, 768-d, MIT
SPARSE_MODEL=Qdrant/bm25                   # keyword half of hybrid search
CHUNK_SIZE_TOKENS=400                      # measured with the embedding model's tokenizer
CHUNK_OVERLAP_TOKENS=60
MODEL_CACHE_DIR=./.models                  # models are downloaded here once (~220 MB)
MAX_PDF_PAGES=2000
MAX_SHEET_ROWS=100000
INGESTION_MAX_TRIES=3
WORKER_MAX_JOBS=2                          # embedding is CPU-bound; scale with more worker processes

# --- Retrieval (Phase 4) ---
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base      # best of those benchmarked; ~2.7 s / 20 passages on CPU
RERANK_CANDIDATES=20
RETRIEVAL_TOP_N=8                          # chunks given to the LLM
RETRIEVAL_MIN_RELEVANCE=0.002              # calibrated for bge-reranker-base; below -> "not found"
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=4
CONTEXT_MAX_TOKENS=6000

# --- Generation (Phase 4) ---
# The key for the chosen provider is required for chat answers (search works without it).
# Never commit a real key.
LLM_PROVIDER=anthropic                     # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-opus-5-5                  # e.g. gpt-5-nano with LLM_PROVIDER=openai
LLM_EFFORT=medium                          # none | minimal (OpenAI) | low | medium | high | xhigh | max
LLM_MAX_TOKENS=8000
LLM_REFUSAL_FALLBACK=true                  # server-side fallback on policy declines (Claude API only)
CHAT_HISTORY_TURNS=6
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=60

# --- Rate limits (requests per minute) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
