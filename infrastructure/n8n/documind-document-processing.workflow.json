    {
      "parameters": {
        "jsCode": "// Decides what happens next from the job status (PostgreSQL is the source of truth; nothing is kept here).\nconst s = $input.first().json;\nconst maxPolls = parseInt($env.DOCUMIND_MAX_POLLS || '720');\nconst pollSeconds = parseInt($env.DOCUMIND_POLL_SECONDS || '5');\nconst polls = $runIndex;\nlet decision;\nif (s.state === 'succeeded') {\n  decision = 'succeeded';\n} else if (s.state === 'failed') {\n  // can_retry: a temporary failure with retries left. retryable without can_retry: retries used up.\n  decision = s.can_retry ? 'retry' : (s.retryable ? 'exhausted' : 'failed');\n} else {\n  // queued / running, or no usable answer (the backend may be restarting): keep polling, within a limit.\n  decision = polls >= maxPolls ? 'timeout' : 'poll';\n}\nreturn [{ json: { ...s, decision, polls, wait_seconds: decision === 'retry' ? (s.retry_after_seconds || 30) : pollSeconds } }];"
      },
