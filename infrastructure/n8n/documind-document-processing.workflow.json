    {
      "parameters": {
        "jsCode": "// Checks the shared secret and the required fields. Nothing from the event is trusted beyond these ids.\nconst item = $input.first().json;\nconst headers = item.headers || {};\nconst body = item.body || {};\nconst secret = $env.DOCUMIND_WEBHOOK_SECRET || '';\nconst presented = String(headers['x-documind-webhook-secret'] || '');\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\n// Constant-time comparison.\nlet diff = secret.length ^ presented.length;\nfor (let i = 0; i < Math.max(secret.length, presented.length); i++) {\n  diff |= (secret.charCodeAt(i) || 0) ^ (presented.charCodeAt(i) || 0);\n}\nconst authorized = secret.length > 0 && diff === 0;\n\nconst errors = [];\nif (body.event !== 'document.uploaded') errors.push('unexpected event type');\nfor (const field of ['document_id', 'job_id', 'organization_id']) {\n  if (!uuid.test(String(body[field] || ''))) errors.push('invalid ' + field);\n}\nconst valid = authorized && errors.length === 0;\nreturn [{\n  json: {\n    valid,\n    authorized,\n    errors: authorized ? errors : ['not authorized'],\n    event: valid ? {\n      event_id: body.event_id || null,\n      document_id: body.document_id,\n      job_id: body.job_id,\n      organization_id: body.organization_id,\n      file_type: body.file_type || null,\n      title: body.title || null,\n    } : null,\n  },\n}];"
      },
