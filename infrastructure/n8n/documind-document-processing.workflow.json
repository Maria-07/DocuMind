    {
      "parameters": {
        "jsCode": "// A short message for the outcome. Ids and the file type only (a title only if the backend was set to send one);\n// never file contents, extracted text or links.\nconst ev = $('Validate Event').first().json.event;\nlet kind = 'attention';\ntry { kind = $('Evaluate Status').last().json.decision; } catch (e) { /* processing never started */ }\nlet status = {};\ntry { status = $('Evaluate Status').last().json; } catch (e) { status = {}; }\nconst label = (ev.title ? '\"' + ev.title + '\" ' : '') + '(' + (ev.file_type || 'document') + ', ' + ev.document_id + ')';\nconst messages = {\n  succeeded: 'DocuMind: ' + label + ' was processed successfully.',\n  failed: 'DocuMind: processing of ' + label + ' failed permanently (' + (status.error_code || 'error') + ').',\n  exhausted: 'DocuMind: processing of ' + label + ' failed after ' + (status.retry_count || 0) + ' retries (' + (status.error_code || 'error') + '). An administrator may need to look at it.',\n  timeout: 'DocuMind: ' + label + ' is still being processed after the maximum monitoring time. Please check on it.',\n  attention: 'DocuMind: processing of ' + label + ' could not be started and needs attention.',\n};\nconst severity = kind === 'succeeded' ? 'success' : (kind === 'failed' || kind === 'exhausted' ? 'error' : 'warning');\nreturn [{ json: { kind, severity, text: messages[kind] || messages.attention,\n  document_id: ev.document_id, job_id: ev.job_id, organization_id: ev.organization_id, execution_id: String($execution.id) } }];"
      },
